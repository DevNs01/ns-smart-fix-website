# Server-only Vercel variables for quotation email delivery.
# Never place these values in VITE_* variables because Vite exposes them to browsers.
RESEND_API_KEY=
QUOTATION_FROM_EMAIL="NS Smart Fix Website <website@nssmartfixsolution.com>"
QUOTATION_TO_EMAIL=admin@nssmartfixsolution.com

# Cloudflare Turnstile. The site key is public but supplied through /api/security-config.
# Keep the secret key server-only and never prefix it with VITE_.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Privacy-conscious operational monitoring. Generate CRON_SECRET as a long random value.
MONITORING_ALERT_EMAIL=admin@nssmartfixsolution.com
MONITORING_SLOW_API_MS=3000
MONITORING_ALERT_COOLDOWN_MS=900000
CRON_SECRET=
